generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String
  createdAt    DateTime  @default(now())
  refreshToken String?   @unique
  verified     Boolean   @default(false)
  doctor       Doctor?
  hospital     Hospital?
  otp          Otp?
  patient      Patient?
}

model Patient {
  id            String             @id @default(uuid())
  userId        String             @unique
  name          String
  dob           DateTime
  gender        String
  bloodGroup    String?
  contact       String?
  permissions   AccessPermission[]
  appointments  Appointment[]
  records       MedicalRecord[]
  user          User               @relation(fields: [userId], references: [id])
  prescriptions Prescription[]
}

model Doctor {
  id             String             @id @default(uuid())
  userId         String             @unique
  name           String
  specialization String
  licenseNo      String?
  hospitalId     String?
  permissions    AccessPermission[]
  appointments   Appointment[]
  hospital       Hospital?          @relation(fields: [hospitalId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  records        MedicalRecord[]
  prescriptions  Prescription[]
}

model Hospital {
  id             String          @id @default(uuid())
  name           String
  address        String
  registrationNo String?
  userId         String          @unique
  appointments   Appointment[]
  doctors        Doctor[]
  user           User            @relation(fields: [userId], references: [id])
  records        MedicalRecord[]
}

model AccessPermission {
  id         String    @id @default(uuid())
  patientId  String
  doctorId   String
  status     String    @default("pending")
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  doctor     Doctor    @relation(fields: [doctorId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
}

model MedicalRecord {
  id         String    @id @default(uuid())
  patientId  String
  doctorId   String?
  hospitalId String?
  recordType String
  fileUrl    String?
  uploadDate DateTime  @default(now())
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
}

model Prescription {
  id         String   @id @default(uuid())
  patientId  String
  doctorId   String
  medicines  String
  notes      String?
  issuedDate DateTime @default(now())
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id])
}

model Appointment {
  id          String    @id @default(uuid())
  patientId   String
  doctorId    String
  hospitalId  String?
  scheduledAt DateTime
  status      String    @default("booked")
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  patient     Patient   @relation(fields: [patientId], references: [id])
}

model Otp {
  id        String    @id @default(cuid())
  email     String    @unique
  otpHash   String
  createdAt DateTime  @default(now())
  userId    String    @unique
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}
